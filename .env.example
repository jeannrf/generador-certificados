# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local.

# ID de cliente OAuth de Google para guardar en Drive (público). Ver docs/12-google-drive-y-qr.md
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Cuenta Gmail que envía los correos (función api/send-email). Secretos: no usar prefijo VITE_
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
